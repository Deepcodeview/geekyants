    "name": "AI Assessment Platform — Complete API Suite",
    "description": "Full end-to-end API collection for the AI Customized Project Assessment Platform. Covers Intake, Blueprint generation, GitHub Provisioning, Submission Freeze, HMAC Callbacks, MCQ Evaluation, and Final Hiring Reports.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
