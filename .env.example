# Backend (Spring Boot). Values shown are examples.
DB_URL=jdbc:mysql://localhost:3306/assessment?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=assessment
DB_PASSWORD=assessment

# Public URL GitHub and the evaluation runner call back to (must be reachable from GitHub).
APP_PUBLIC_BASE_URL=https://assessment.example.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Auth: set an OIDC issuer in shared environments. Leave empty and use the "dev" profile locally.
OIDC_ISSUER_URI=

# GitHub organization that owns candidate repositories.
GITHUB_ORG=assessment-platform
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_EVALUATION_REPO=evaluation-runner
GITHUB_ENFORCE_RULESETS=true

# Shared with the evaluation-runner repository secret EVALUATION_CALLBACK_SECRET.
EVALUATION_CALLBACK_SECRET=

# Claude API.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
